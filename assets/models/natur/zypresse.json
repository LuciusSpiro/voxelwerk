{
  "id": "natur/zypresse",
  "name": "Zypresse",
  "tier": "detail",
  "palette": "planet_mediterran",
  "tags": ["natur", "baum", "zypresse"],
  "footprint": [0.6, 0.6],
  "params": {
    "h": { "default": 96, "min": 64, "max": 120, "step": 4, "label": "Höhe (Voxel, 16/m)" },
    "R": { "default": 8, "min": 5, "max": 11, "step": 0.5, "label": "Kronenradius (Voxel)" }
  },
  "let": { "n": "floor((h - 12) / 4)" },
  "variants": {
    "schlank": { "h": 108, "R": 6.5 },
    "jung": { "h": 72, "R": 6 },
    "breit": { "h": 88, "R": 10 }
  },
  "ops": [
    { "op": "cyl", "name": "Stammfuß", "at": [0, 0, 0], "r": 1.8, "r2": 1.2, "h": 3, "color": "wood_dark" },
    { "op": "cyl", "name": "Stamm", "at": [0, 3, 0], "r": 1.2, "h": 12, "color": { "noise": ["wood_dark", "wood"], "weights": [3, 1] } },
    { "op": "group", "name": "Kronenetage", "repeat": { "count": "n", "step": [0, 4, 0], "var": "i" },
      "let": {
        "t": "i / max(1, n - 1)",
        "rr": "R * (t < 0.3 ? 0.6 + t * 1.33 : 1.11 - t) + 0.8",
        "ox": "sin(i * 2.7 + seed * 1.3) * 0.9",
        "oz": "cos(i * 1.9 + seed * 2.1) * 0.9",
        "a": "i * 2.4 + seed * 1.7"
      },
      "ops": [
        { "op": "ellipsoid", "name": "Büschel", "at": ["ox", 12, "oz"], "r": ["rr", 4.6, "rr"], "color": { "noise": ["plant_dark", "plant", { "shade": "plant_dark", "f": 0.78 }], "weights": [4, 2, 2], "cell": 2 } },
        { "op": "ellipsoid", "name": "Außenbüschel", "at": ["ox + cos(a) * rr * 0.75", 14, "oz + sin(a) * rr * 0.75"], "r": ["rr * 0.45 + 0.8", 2.6, "rr * 0.45 + 0.8"], "color": { "noise": ["plant", "plant_dark", "plant_light"], "weights": [3, 3, 1] } },
        { "op": "ellipsoid", "name": "Gegenbüschel", "at": ["ox - cos(a + 1) * rr * 0.7", 11, "oz - sin(a + 1) * rr * 0.7"], "r": ["rr * 0.4 + 0.7", 2.4, "rr * 0.4 + 0.7"], "color": { "noise": ["plant_dark", { "shade": "plant_dark", "f": 0.8 }], "weights": [2, 1] } }
      ] },
    { "op": "ellipsoid", "name": "Spitze", "at": [0, "12 + n * 4 + 1", 0], "r": [1.2, 3, 1.2], "color": "plant" }
  ],
  "anchor": [0, 0, 0]
}
