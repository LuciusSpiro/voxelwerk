{
 "id": "biom/vulkan/aschefarn",
 "name": "Aschefarn (VOX-02): Sichtschleier der Vulkanzone, 0,8 bis 1,0 m, ohne Kollision, sperrt die Sicht. Graue, eckige Zackenblätter (breite Stufen, nach außen ansteigend wie ein Kelch, hellere Spitzen) um eine Mittelzacke, anderes Rezept als der Wiesenfarn; keine Glut, kein Leuchten. seed ändert Höhen, verschiebt die Pflanze um bis zu 1 Voxel und lässt einzelne Blätter aus",
 "tier": "detail",
 "palette": "biom_vulkan",
 "jitter": 0,
 "tags": [
  "biom",
  "vulkan",
  "farn",
  "sichtschleier"
 ],
 "footprint": [
  1,
  1
 ],
 "budgetTris": 600,
 "let": {
  "sx": "round((hash(seed, 5) - 0.5) * 2)",
  "sz": "round((hash(seed, 6) - 0.5) * 2)"
 },
 "ops": [
  {
   "op": "group",
   "name": "Pflanze",
   "at": [
    "sx",
    0,
    "sz"
   ],
   "ops": [
    {
     "op": "box",
     "name": "Saum",
     "at": [
      -5,
      0,
      -5
     ],
     "size": [
      10,
      2,
      10
     ],
     "color": "stone_dark"
    },
    {
     "op": "box",
     "name": "Mittelzacke",
     "at": [
      -1,
      5,
      -1
     ],
     "size": [
      2,
      "8 + floor(hash(seed, 1) * 4)",
      2
     ],
     "color": "grass_dark"
    },
    {
     "op": "group",
     "name": "Blätter gerade",
     "repeat": {
      "count": 4,
      "step": [
       0,
       0,
       0
      ],
      "var": "k"
     },
     "rot": "k * 90",
     "if": "k % 2 == 0 || hash(seed, k, 9) > 0.3",
     "let": {
      "a": "floor(hash(seed, k, 1) * 3)",
      "b": "floor(hash(seed, k, 2) * 4)"
     },
     "ops": [
      {
       "op": "box",
       "name": "Blatt unten",
       "at": [
        2,
        3,
        -2
       ],
       "size": [
        3,
        "4 + a",
        4
       ],
       "color": "grass_dark"
      },
      {
       "op": "box",
       "name": "Blatt Zacke",
       "at": [
        5,
        6,
        -1
       ],
       "size": [
        2,
        "4 + b",
        2
       ],
       "color": "stone_light"
      }
     ]
    },
    {
     "op": "group",
     "name": "Blätter schräg",
     "repeat": {
      "count": 4,
      "step": [
       0,
       0,
       0
      ],
      "var": "k"
     },
     "rot": "k * 90",
     "if": "k == 1 || hash(seed, k, 19) > 0.3",
     "let": {
      "a": "floor(hash(seed, k, 11) * 3)"
     },
     "ops": [
      {
       "op": "box",
       "name": "Schräg Zacke",
       "at": [
        2,
        3,
        2
       ],
       "size": [
        3,
        "5 + a",
        3
       ],
       "color": "stone_dark"
      }
     ]
    }
   ]
  }
 ],
