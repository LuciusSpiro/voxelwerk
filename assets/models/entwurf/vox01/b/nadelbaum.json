{
  "id": "entwurf/vox01/b/nadelbaum",
  "name": "VOX-01 B Via Appia: Pinie (Nadelbaum, Schirmkrone)",
  "tier": "detail",
  "palette": "planet_mediterran",
  "jitter": 0,
  "tags": ["entwurf", "natur", "baum", "nadelbaum"],
  "footprint": [1, 1],
  "params": {
    "h": { "default": 76, "min": 60, "max": 96, "step": 4, "label": "Höhe (Voxel, 16/m)" },
    "R": { "default": 23, "min": 14, "max": 24, "step": 1, "label": "Schirmradius (Voxel)" },
    "teil": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "0 ganz · 1 nur Stamm · 2 nur Krone" }
  },
  "let": {
    "hh": "h + floor(hash(seed, 1) * 3) * 6 - 6",
    "RR": "min(24, R - 2 + floor(hash(seed, 2) * 3))",
    "a0": "hash(seed, 3) * 6.283",
    "lx": "cos(a0) * 4",
    "lz": "sin(a0) * 4",
    "yc": "hh - 12"
  },
  "variants": { "stamm": { "teil": 1 }, "krone": { "teil": 2 }, "jung": { "h": 60, "R": 16 } },
  "ops": [
    { "op": "cyl", "name": "Stammfuß", "if": "teil != 2", "at": [0, 0, 0], "r": 4, "r2": 3, "h": 3, "color": "wood_dark" },
    { "op": "line", "name": "Stamm unten", "if": "teil != 2", "from": [0.5, 2, 0.5], "to": ["0.5 + lx * 0.4", "yc * 0.5", "0.5 + lz * 0.4"], "r": 2.6, "color": { "stripes": ["wood", { "shade": "wood", "f": 0.8 }], "axis": "y", "period": 4 } },
    { "op": "line", "name": "Stamm oben", "if": "teil != 2", "from": ["0.5 + lx * 0.4", "yc * 0.5", "0.5 + lz * 0.4"], "to": ["0.5 + lx", "yc + 2", "0.5 + lz"], "r": 2.1, "color": { "stripes": ["wood", { "shade": "wood", "f": 0.8 }], "axis": "y", "period": 4 } },
    { "op": "line", "name": "Gabelast", "if": "teil != 2", "repeat": { "count": 3, "step": [0, 0, 0], "var": "k" }, "from": ["0.5 + lx", "yc", "0.5 + lz"], "to": ["0.5 + lx + cos(a0 + 1 + k * 2.1) * RR * 0.5", "yc + 4", "0.5 + lz + sin(a0 + 1 + k * 2.1) * RR * 0.5"], "r": 1.2, "color": "wood" },
    { "op": "ellipsoid", "name": "Schirm unten", "if": "teil != 1", "at": ["lx", "yc + 3", "lz"], "r": ["RR", 4, "RR"], "color": "plant_dark" },
    { "op": "ellipsoid", "name": "Schirm oben", "if": "teil != 1", "at": ["lx", "yc + 6", "lz"], "r": ["RR * 0.86", 5, "RR * 0.86"], "half": "+y", "color": "plant" },
    { "op": "ellipsoid", "name": "Polster", "if": "teil != 1", "repeat": { "count": 5, "step": [0, 0, 0], "var": "k" },
      "at": ["lx + cos(a0 + k * 1.257) * RR * 0.55", "yc + 8", "lz + sin(a0 + k * 1.257) * RR * 0.55"], "r": ["RR * 0.3", 3, "RR * 0.3"], "half": "+y", "color": "plant_light" }
  ],
  "anchor": [0, 0, 0]
}
