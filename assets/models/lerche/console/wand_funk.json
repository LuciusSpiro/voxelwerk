{
  "id": "lerche/console/wand_funk",
  "name": "Wandpult Funk: Sprechmuschel mit Frequenzskala (Lerche)",
  "tier": "detail",
  "palette": "lerche_rom",
  "tags": ["lerche", "konsole", "bruecke", "funk"],
  "footprint": [1, 1],
  "params": {
    "occupied": { "default": 0, "min": 0, "max": 1, "step": 1, "label": "besetzt (Leuchtrand)" }
  },
  "variants": {
    "besetzt": { "occupied": 1 }
  },
  "ops": [
    { "op": "use", "name": "Besetzt-Rand", "model": "lerche/station/parts_c/rim", "at": [0, 0, 0], "params": { "w": 16, "d": 14, "on": "occupied" } },
    { "op": "use", "name": "Sockel", "model": "lerche/station/parts_c/plinth", "at": [0, 0, -1], "params": { "w": 14, "d": 10, "h": 2 } },

    { "op": "box", "name": "Pultkasten (Marmor)", "at": [-6, 2, -6], "size": [12, 9, 8], "color": "secondary" },
    { "op": "box", "name": "Kasten Rotfeld", "at": [-5, 3, 1], "size": [10, 7, 1], "color": { "frame": "trim", "fill": "primary", "axes": "xy", "width": 1 } },
    { "op": "box", "name": "Goldleiste unten", "at": [-6, 2, 2], "size": [12, 1, 1], "color": "trim" },

    { "op": "box", "name": "Pultplatte", "at": [-7, 11, -7], "size": [14, 2, 12], "color": "metal_dark" },
    { "op": "box", "name": "Pultrahmen Gold", "at": [-7, 12, -7], "size": [14, 1, 12], "color": { "frame": "trim", "fill": "metal", "axes": "xz", "width": 1 } },

    { "op": "box", "name": "Frequenzskala dunkel", "at": [-6, 12, -5], "size": [12, 1, 7], "color": "dark", "jitter": false },
    { "op": "box", "name": "Skalasteine", "repeat": { "count": 3, "step": [4, 0, 0], "var": "k" }, "at": [-4, 12, -4], "size": [1, 1, 5], "color": { "shade": "glow", "f": 0.45 }, "jitter": false },
    { "op": "box", "name": "Zeigerleiste", "at": [-6, 12, -1], "size": [12, 1, 1], "mode": "paint", "color": { "role": "glow2", "emit": 0.9 }, "jitter": false },
    { "op": "box", "name": "Zeiger", "at": [1, 13, -2], "size": [1, 1, 3], "color": "trim" },

    { "op": "cyl", "name": "Drehregler", "repeat": { "count": 2, "step": [6, 0, 0], "var": "k" }, "at": ["-3 + 6 * k", 13, 2], "r": 2, "h": 2, "color": "metal" },
    { "op": "box", "name": "Reglerstrich", "repeat": { "count": 2, "step": [6, 0, 0], "var": "k" }, "at": ["-3 + 6 * k", 15, 2], "size": [1, 1, 2], "mode": "paint", "color": { "role": "glow2", "emit": 0.8 }, "jitter": false },

    { "op": "cyl", "name": "Muschelstiel", "at": [0, 13, -4], "r": 1.5, "h": 4, "color": "metal_dark" },
    { "op": "cyl", "name": "Sprechmuschel", "at": [0, 17, -4], "r": 1.5, "r2": 4, "h": 5, "color": "trim" },
    { "op": "box", "name": "Muschelmund", "at": [-2, 19, 1], "size": [4, 3, 1], "mode": "paint", "color": "dark", "jitter": false },
    { "op": "box", "name": "Muschelklang", "at": [-1, 19, 2], "size": [2, 2, 1], "color": { "role": "glow", "emit": 1.0 }, "jitter": false }
  ],
  "anchor": [0, 0, 0]
}
