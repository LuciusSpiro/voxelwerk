{
  "id": "kit/germanen/aussenposten/tuer_rahmen",
  "name": "Außenposten Stabbau – tuer_rahmen: Eisenschwelle mit Glutlinie (teil 0), Kupfer-Sturzbalken mit drei Runenpunkten (teil 1)",
  "tier": "architecture",
  "palette": "nord",
  "tags": ["germanen", "aussenposten", "slot", "stabbau", "ort01"],
  "notes": "ORT-01 K1 (Gruppe 2b). Schwelle in der Bodenschicht, Sturz oberhalb der Öffnung (nicht bei cut). Glutlinie erloschen, wenn gesprengt (state 3) oder umkämpft.",
  "jitter": 0,
  "params": {
    "w": { "default": 8, "min": 1, "max": 16, "step": 1, "label": "Breite (Voxel)" },
    "h": { "default": 3, "min": 1, "max": 16, "step": 1, "label": "Höhe (Voxel)" },
    "d": { "default": 4, "min": 1, "max": 4, "step": 1, "label": "Tiefe (Voxel)" },
    "zustand": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "0 intakt · 1 verfallen · 2 umkämpft" },
    "teil": { "default": 1, "min": 0, "max": 1, "step": 1, "label": "0 Schwelle · 1 Sturz" },
    "state": { "default": 0, "min": 0, "max": 3, "step": 1, "label": "Türzustand" }
  },
  "let": { "dk": "1 - zustand * 0.1", "em": "(state == 3 || zustand == 2) ? 0 : 0.5" },
  "variants": { "schwelle": { "teil": 0, "h": 1 }, "gesprengt": { "state": 3 } },
  "ops": [
    { "name": "Schwelle", "op": "box", "at": [0, 0, 0], "size": ["w", "h", "d"], "color": { "shade": "metal_dark", "f": "dk" }, "if": "teil == 0" },
    { "name": "Schwelle Glutlinie", "op": "box", "at": [1, "h - 1", "d - 2"], "size": ["w - 2", 1, 1], "mode": "paint", "color": { "role": "ember", "emit": "em" }, "if": "teil == 0 && w >= 4 && em > 0" },
    { "name": "Sturz", "op": "box", "at": [0, 0, 0], "size": ["w", "h", "d"], "color": { "shade": "metal_dark", "f": "dk" }, "if": "teil == 1" },
    { "name": "Sturzbalken Kupfer", "op": "box", "at": [0, 0, 0], "size": ["w", 1, "d"], "mode": "paint", "color": { "shade": "copper", "f": "dk" }, "if": "teil == 1" },
    { "name": "Runenpunkte", "op": "box", "at": ["1 + i * floor((w - 3) / 2)", 1, "d - 1"], "size": [1, 1, 1], "mode": "paint", "color": { "role": "rune_dim", "emit": "em" }, "if": "teil == 1 && h >= 3 && w >= 6 && em > 0", "repeat": { "count": 3, "step": [0, 0, 0], "var": "i" } },
    { "name": "Ruß (gesprengt/umkämpft)", "op": "box", "at": [0, 0, 0], "size": ["w", "h", "d"], "mode": "paint", "color": { "noise": [{ "shade": "metal_dark", "f": 0.65 }, "dark"], "weights": [2, 1], "seed": "seed" }, "if": "teil == 1 && (state == 3 || zustand == 2)" }
  ],
  "anchor": [0, 0, 0]
}
