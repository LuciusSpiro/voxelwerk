{
  "id": "kit/rom/aussenposten/wand_fuellung",
  "name": "Rom Außenposten wand_fuellung: Marmorpaneel mit Paneelfuge; je Seed ein flächenbündiges Gunmetal-Aggregatfeld mit Goldrahmen",
  "tier": "architecture",
  "palette": "rom",
  "tags": [
    "rom",
    "aussenposten",
    "slot",
    "ort01"
  ],
  "jitter": 0,
  "params": {
    "w": {
      "default": 4,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Breite (Voxel)"
    },
    "h": {
      "default": 9,
      "min": 1,
      "max": 16,
      "step": 1,
      "label": "Höhe (Voxel)"
    },
    "d": {
      "default": 1,
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Tiefe (Voxel)"
    },
    "zustand": {
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 1,
      "label": "0 intakt · 1 verfallen · 2 umkämpft"
    }
  },
  "ops": [
    {
      "name": "Marmor",
      "op": "box",
      "at": [
        0,
        0,
        0
      ],
      "size": [
        "w",
        "h",
        "d"
      ],
      "color": {
        "shade": "secondary",
        "f": "1 * (1 - zustand * 0.06)"
      }
    },
    {
      "name": "Paneelfuge",
      "op": "box",
      "if": "h > 5",
      "at": [
        0,
        "floor(h / 2)",
        0
      ],
      "size": [
        "w",
        1,
        "d"
      ],
      "color": {
        "shade": "secondary",
        "f": "0.8 * (1 - zustand * 0.06)"
      }
    },
    {
      "name": "Aggregatfeld",
      "op": "box",
      "if": "w >= 4 && h >= 7 && floor(seed) % 4 == 1",
      "at": [
        0,
        2,
        0
      ],
      "size": [
        "w",
        "h - 4",
        "d"
      ],
      "color": {
        "frame": {
          "shade": "trim",
          "f": "0.9 * (1 - zustand * 0.06)"
        },
        "fill": {
          "shade": "metal_dark",
          "f": "1.3 * (1 - zustand * 0.06)"
        },
        "axes": "y",
        "width": 1
      }
    }
  ],
  "anchor": [
    0,
    0,
    0
  ]
}