{
  "id": "ort/germanen/esse/fassregal",
  "name": "Fasszellen-Regal (Germanen, Richtung Esse): Eisenbock mit liegenden Fass-Akkus, Stirnseiten mit Runensiegel, Glut-Sammelschiene, wandnah",
  "tier": "detail",
  "palette": "nord",
  "jitter": 0,
  "tags": ["prop", "germanen", "lager", "energie", "ort01"],
  "footprint": [2, 0.75],
  "params": {
    "belegt": { "default": 6, "min": 0, "max": 6, "step": 1, "label": "Fässer eingelegt" }
  },
  "variants": { "halb": { "belegt": 3 } },
  "ops": [
    { "op": "box", "name": "Pfosten", "at": [-16, 0, -6], "size": [2, 24, 2], "color": "metal_dark", "repeat": { "count": 2, "step": [30, 0, 0] } },
    { "op": "box", "name": "Pfosten vorn", "at": [-16, 0, 4], "size": [2, 24, 2], "color": "metal_dark", "repeat": { "count": 2, "step": [30, 0, 0] } },
    { "op": "box", "name": "Nieten", "at": [-16, "3 + i*5", 6], "size": [2, 1, 1], "color": "copper", "repeat": { "count": 4, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Nieten 3", "at": [14, "3 + i*5", 6], "size": [2, 1, 1], "color": "copper", "repeat": { "count": 4, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Rückwand", "at": [-16, 0, -6], "size": [32, 22, 2], "color": "metal_dark" },
    { "op": "box", "name": "Bock unten", "at": [-16, 0, -6], "size": [32, 2, 12], "color": "metal" },
    { "op": "box", "name": "Bock Mitte", "at": [-16, 11, -6], "size": [32, 1, 12], "color": "metal" },
    { "op": "box", "name": "Bock oben", "at": [-16, 22, -6], "size": [32, 2, 12], "color": "metal_dark" },
    { "op": "box", "name": "Sammelschiene", "at": [-16, 24, -2], "size": [32, 1, 2], "color": { "role": "ember", "emit": 0.8 } },
    { "op": "box", "name": "Schiene Fassung", "at": [-16, 24, -3], "size": [32, 2, 1], "color": "copper_dark", "mirror": "z", "mirrorAt": -1 },
    { "op": "group", "name": "Fässer", "ops": [
      { "op": "cyl", "name": "Fass", "if": "i < belegt", "at": ["-10 + i*10", 6.5, 0], "r": 4.5, "h": 6, "axis": "z", "color": "metal", "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "cyl", "name": "Fass2", "if": "(3 + i) < belegt", "at": ["-10 + i*10", 17.5, 0], "r": 4.5, "h": 6, "axis": "z", "color": "metal", "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "box", "name": "Reif", "mode": "paint", "if": "i < belegt", "at": ["-15 + i*10", 1, 3], "size": [10, 11, 1], "color": "copper_dark", "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "box", "name": "Reif2", "mode": "paint", "if": "(3 + i) < belegt", "at": ["-15 + i*10", 12, 3], "size": [10, 11, 1], "color": "copper_dark", "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "box", "name": "Siegel", "if": "i < belegt", "at": ["-11 + i*10", 5, 6], "size": [2, 3, 1], "color": { "role": "rune", "emit": 0.9 }, "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "box", "name": "Siegel2", "if": "(3 + i) < belegt", "at": ["-11 + i*10", 16, 6], "size": [2, 3, 1], "color": { "role": "rune", "emit": 0.9 }, "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } }
    ] }
  ],
  "anchor": [0, 0, 0]
}
