{
  "id": "ort/germanen/spant/terminal",
  "name": "Runenstelen-Pult (Germanen, Richtung Spant): hohe frostblaue Schaltstele mit Runen-Leiterbahnen, zwei Knochenspanten bilden den Spitzbogen, Hörer als Horn",
  "tier": "detail",
  "palette": "nord",
  "jitter": 0,
  "tags": ["prop", "germanen", "terminal", "kommando", "ort01"],
  "footprint": [1, 1],
  "params": {
    "state": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Zustand (0 bereit, 1 lädt, 2 gesperrt)" }
  },
  "let": { "em": "state == 2 ? 0.1 : 1" },
  "variants": { "gesperrt": { "state": 2 } },
  "ops": [
    { "op": "box", "name": "Fuß", "at": [-7, 0, -6], "size": [14, 2, 12], "color": "metal_dark" },
    { "op": "box", "name": "Stele", "at": [-4, 2, -5], "size": [8, 24, 3], "color": "cloth" },
    { "op": "box", "name": "Stele Planken", "at": [-4, 2, -2], "size": [8, 24, 1], "color": { "stripes": ["cloth", { "shade": "cloth", "f": 0.8 }], "axis": "x", "period": 2 } },
    { "op": "box", "name": "Leiterbahn Stamm", "at": [0, 5, -1], "size": [1, 19, 1], "color": { "role": "rune", "emit": "em" } },
    { "op": "box", "name": "Leiterbahn Zweige", "at": ["-3 + (i % 2) * 4", "8 + i*3", -1], "size": [2, 1, 1], "color": { "role": "rune", "emit": "em * 0.9" }, "repeat": { "count": 5, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Leiterbahn Knoten", "at": ["-3 + (i % 2) * 5", "9 + i*3", -1], "size": [1, 1, 1], "color": { "role": "rune_dim", "emit": "em * 0.6" }, "repeat": { "count": 5, "var": "i", "step": [0, 0, 0] } },
    { "op": "line", "name": "Spant links unten", "from": [-6, 2, -3], "to": [-7, 16, -3], "r": 1, "color": "trim" },
    { "op": "line", "name": "Spant links oben", "from": [-7, 16, -3], "to": [0, 29, -3], "r": 1, "color": "trim" },
    { "op": "line", "name": "Spant rechts unten", "from": [6, 2, -3], "to": [7, 16, -3], "r": 1, "color": "trim" },
    { "op": "line", "name": "Spant rechts oben", "from": [7, 16, -3], "to": [0, 29, -3], "r": 1, "color": "trim" },
    { "op": "box", "name": "Pultbrett", "at": [-6, 11, -2], "size": [12, 1, 7], "color": "metal" },
    { "op": "box", "name": "Pultkante Frost", "at": [-6, 11, 5], "size": [12, 1, 1], "color": "frost" },
    { "op": "box", "name": "Tasten", "at": [-4, 12, 2], "size": [1, 1, 1], "color": { "role": "rune", "emit": "em" }, "repeat": { "count": 4, "step": [3, 0, 0] } },
    { "op": "box", "name": "Pultstütze", "at": [-1, 2, 0], "size": [2, 9, 2], "color": "metal_dark" },
    { "op": "line", "name": "Hornhörer", "from": [5, 13, 3], "to": [8, 16, 2], "r": 1, "color": "trim" },
    { "op": "line", "name": "Hornhörer Mündung", "from": [8, 16, 2], "to": [9, 19, 1], "r": 1.5, "color": "trim" },
    { "op": "box", "name": "Sperre", "if": "state == 2", "at": [-3, 14, -1], "size": [6, 2, 1], "color": "alarm" }
  ],
  "anchor": [0, 0, 0]
}
