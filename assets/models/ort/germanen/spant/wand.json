{
  "id": "ort/germanen/spant/wand",
  "name": "Stationswand (Germanen, Richtung Spant): senkrechte frostblaue Stabplanken, knochenweiße Spanten als Rippen, Runen-Leiterbahn auf Augenhöhe",
  "tier": "architecture",
  "palette": "nord",
  "jitter": 0,
  "tags": ["bau", "germanen", "station", "ort01"],
  "footprint": [4, 0.5],
  "params": {
    "len": { "default": 16, "min": 4, "max": 64, "step": 4, "label": "Länge (Voxel, 4 = 1 m)" }
  },
  "ops": [
    { "op": "box", "name": "Kern", "at": ["-len/2", 0, -1], "size": ["len", 12, 2], "color": "secondary" },
    { "op": "box", "name": "Stabplanken", "at": ["-len/2", 1, 1], "size": ["len", 10, 1], "color": { "stripes": ["cloth", { "shade": "cloth", "f": 0.8 }], "axis": "x", "period": 1 } },
    { "op": "box", "name": "Sockel", "at": ["-len/2", 0, 1], "size": ["len", 1, 1], "color": "metal_dark" },
    { "op": "box", "name": "Leiterbahn", "at": ["-len/2", 6, 1], "size": ["len", 1, 1], "mode": "paint", "color": { "role": "rune_dim", "emit": 0.5 } },
    { "op": "box", "name": "Spant", "at": ["-len/2 + 3 + i*8", 0, 1], "size": [1, 10, 2], "color": "trim", "repeat": { "count": "floor(len/8)", "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Spant Knie", "at": ["-len/2 + 3 + i*8", 10, 1], "size": [1, 1, 3], "color": "trim", "repeat": { "count": "floor(len/8)", "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Spant Fuß", "at": ["-len/2 + 2 + i*8", 0, 2], "size": [3, 1, 1], "color": "metal_dark", "repeat": { "count": "floor(len/8)", "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Runenknoten", "at": ["-len/2 + 3 + i*8", 6, 3], "size": [1, 1, 1], "color": { "role": "rune_dim", "emit": 0.5 }, "repeat": { "count": "floor(len/8)", "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Krone", "at": ["-len/2", 11, -1], "size": ["len", 1, 3], "color": "frost_dark" }
  ],
  "anchor": [0, 0, 0]
}
