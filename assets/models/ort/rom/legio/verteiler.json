{
  "id": "ort/rom/legio/verteiler",
  "name": "Signum-Energieverteiler (Rom, Richtung Legio): Feldzeichen-Mast, jede Phalera-Scheibe ein Abgang mit Kabel",
  "tier": "detail",
  "palette": "rom",
  "jitter": 0,
  "tags": ["prop", "rom", "energie", "verteiler", "aussenposten", "ort01"],
  "footprint": [1, 1],
  "params": {
    "abgaenge": { "default": 3, "min": 0, "max": 3, "step": 1, "label": "Abgänge belegt" }
  },
  "variants": { "aus": { "abgaenge": 0 } },
  "ops": [
    { "op": "box", "name": "Fundament", "at": [-7, 0, -7], "size": [14, 2, 14], "color": "metal_dark" },
    { "op": "box", "name": "Gehäuse", "at": [-5, 2, -5], "size": [10, 8, 10], "color": "metal" },
    { "op": "box", "name": "Gehäuse Rot", "at": [-5, 4, 5], "size": [10, 4, 1], "color": { "frame": "trim", "fill": "primary", "axes": "xy", "width": 1 } },
    { "op": "box", "name": "Gehäuse Deckel", "at": [-6, 10, -6], "size": [12, 1, 12], "color": "trim" },
    { "op": "box", "name": "Mast", "at": [-1, 11, -1], "size": [2, 30, 2], "color": "metal_dark" },
    { "op": "cyl", "name": "Phalera", "at": [0, "15 + i*6", 1.5], "r": 2.8, "h": 1, "axis": "z", "color": "trim", "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Phalera Kern", "at": [-1, "14 + i*6", 2], "size": [2, 2, 1], "color": { "role": "glow", "emit": "i < abgaenge ? 1 : 0" }, "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
    { "op": "line", "name": "Kabel", "if": "i < abgaenge", "from": [2, "15 + i*6", 1], "to": ["5 + i", 2, "2 - i*2"], "r": 0.5, "color": "rubber", "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Querholm", "at": [-5, 33, -1], "size": [10, 1, 2], "color": "trim" },
    { "op": "box", "name": "Querholm Enden", "at": [-5, 31, -1], "size": [1, 2, 2], "color": "primary", "mirror": "x", "mirrorAt": 0 },
    { "op": "box", "name": "Kranz", "at": [-2, 41, -2], "size": [4, 1, 4], "color": "trim" },
    { "op": "box", "name": "Spitze", "at": [-1, 42, -1], "size": [2, 3, 2], "color": { "role": "glow", "emit": 1.1 } }
  ],
  "anchor": [0, 0, 0]
}
