{
  "id": "ort/rom/legio/sensorturm",
  "name": "Helmkamm-Sensorturm (Rom, Richtung Legio): Segmentturm, Sensorkopf als Helm, der Querkamm ist eine Antennenreihe",
  "tier": "detail",
  "palette": "rom",
  "jitter": 0,
  "tags": ["prop", "rom", "sensor", "wachturm", "aussenposten", "ort01"],
  "footprint": [1, 1],
  "params": {
    "aktiv": { "default": 1, "min": 0, "max": 1, "step": 1, "label": "Sensor aktiv" }
