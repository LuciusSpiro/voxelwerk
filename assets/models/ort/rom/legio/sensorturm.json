    { "op": "box", "name": "Kamm Antennen", "at": ["-7 + i*2", 47, -1], "size": [1, "6 - abs(i - 3.5) * 0.6", 2], "color": "cloth", "repeat": { "count": 8, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Kamm Spitzen", "at": ["-7 + i*2", "52 - abs(i - 3.5) * 0.6", -1], "size": [1, 1, 2], "color": { "role": "glow", "emit": "aktiv ? 1 : 0" }, "repeat": { "count": 8, "var": "i", "step": [0, 0, 0] } }
  ],
  "anchor": [0, 0, 0]
