{
  "id": "ort/verworfen/spant/hornregal",
  "name": "Hornzellen-Gestell (Germanen, Richtung Spant): Ladebank zwischen zwei Knochenspanten, frostblaue Rückwand mit Runen-Ladebus, wandnah",
  "tier": "detail",
  "palette": "nord",
  "jitter": 0,
  "tags": ["prop", "germanen", "lager", "energie", "ort01"],
  "footprint": [2, 0.75],
  "params": {
    "belegt": { "default": 0, "min": 0, "max": 4, "step": 1, "label": "Hörner eingesetzt" }
  },
  "variants": { "voll": { "belegt": 4 } },
  "ops": [
    { "op": "box", "name": "Ladebank", "at": [-15, 0, -5], "size": [30, 3, 10], "color": "metal_dark" },
    { "op": "box", "name": "Ladebank Kante", "at": [-15, 3, 4], "size": [30, 1, 1], "color": "frost" },
    { "op": "box", "name": "Ladeplätze", "at": ["-12 + i*7", 3, -2], "size": [5, 1, 5], "color": "copper_dark", "repeat": { "count": 4, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Rückwand", "at": [-14, 3, -6], "size": [28, 20, 2], "color": { "stripes": ["cloth", { "shade": "cloth", "f": 0.82 }], "axis": "x", "period": 2 } },
    { "op": "box", "name": "Ladebus", "at": [-13, 20, -4], "size": [26, 1, 1], "color": { "role": "rune", "emit": 0.8 } },
    { "op": "box", "name": "Abgriffe", "at": ["-10 + i*7", 8, -4], "size": [1, 12, 1], "color": { "role": "rune_dim", "emit": 0.5 }, "repeat": { "count": 4, "var": "i", "step": [0, 0, 0] } },
    { "op": "group", "name": "Spanten", "mirror": "x", "mirrorAt": 0, "ops": [
      { "op": "line", "name": "Spant unten", "from": [15, 0, -2], "to": [16, 14, -2], "r": 1, "color": "trim" },
      { "op": "line", "name": "Spant oben", "from": [16, 14, -2], "to": [12, 25, -3], "r": 1, "color": "trim" }
    ] },
    { "op": "box", "name": "Querholm", "at": [-13, 24, -5], "size": [26, 2, 3], "color": "trim" },
    { "op": "use", "name": "Hörner", "model": "ort/verworfen/spant/hornzelle", "if": "i < belegt", "at": ["-10.5 + i*7", 3, 1], "repeat": { "count": 4, "var": "i", "step": [0, 0, 0] } }
  ],
  "anchor": [0, 0, 0]
}
