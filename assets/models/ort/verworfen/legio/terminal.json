{
  "id": "ort/verworfen/legio/terminal",
  "name": "Scutum-Kommandopult (Rom, Richtung Legio): Gunmetal-Pult, Schirm im gewölbten Schild, Buckel als Holoprojektor",
  "tier": "detail",
  "palette": "rom",
  "jitter": 0,
  "tags": ["prop", "rom", "terminal", "kommando", "ort01"],
  "footprint": [1, 1],
  "params": {
    "state": { "default": 0, "min": 0, "max": 2, "step": 1, "label": "Zustand (0 bereit, 1 lädt, 2 gesperrt)" }
  },
  "let": { "em": "state == 2 ? 0.2 : 1" },
  "variants": { "gesperrt": { "state": 2 } },
  "ops": [
    { "op": "box", "name": "Fuß", "at": [-7, 0, -6], "size": [14, 2, 12], "color": "metal_dark" },
    { "op": "box", "name": "Fuß Gold", "at": [-7, 2, -6], "size": [14, 1, 12], "color": { "frame": "trim", "fill": "metal_dark", "axes": "xz", "width": 1 } },
    { "op": "box", "name": "Säule", "at": [-3, 3, -2], "size": [6, 8, 4], "color": "metal" },
    { "op": "box", "name": "Segmentbänder", "at": [-4, "4 + i*3", -3], "size": [8, 1, 6], "color": "trim", "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
    { "op": "wedge", "name": "Pultplatte", "at": [-7, 11, -2], "size": [14, 2, 8], "slope": "+z", "color": "metal_dark" },
    { "op": "box", "name": "Pultkante", "at": [-7, 11, 6], "size": [14, 1, 1], "color": "trim" },
    { "op": "box", "name": "Tasten", "at": [-5, 12, 3], "size": [1, 1, 1], "color": { "role": "glow", "emit": "em" }, "repeat": { "count": 6, "step": [2, 0, 0] } },
    { "op": "box", "name": "Stütze", "at": [-1, 11, -6], "size": [2, 6, 2], "color": "metal_dark" },
    { "op": "use", "name": "Schild-Schirm", "model": "ort/verworfen/legio/scutum_paneel", "params": { "w": 14, "h": 16, "fenster": 1, "em": "em" }, "at": [0, 13, -6] },
    { "op": "box", "name": "Buckel-Projektor", "at": [-2, 25, -3], "size": [4, 2, 3], "color": "trim" },
    { "op": "box", "name": "Holo Strahl", "if": "state != 2", "at": [-1, 27, -2], "size": [2, 2, 2], "color": { "role": "glow", "emit": 0.9 } }
  ],
  "anchor": [0, 0, 0]
}
