{
  "id": "ort/verworfen/legio/reaktor",
  "name": "Legionsreaktor (Rom, Richtung Legio): Kernsäule aus Lorica-Segmentringen, vier Signum-Feldmasten halten das Einschlussfeld",
  "tier": "detail",
  "palette": "rom",
  "jitter": 0,
  "tags": ["prop", "rom", "reaktor", "hauptstueck", "ort01"],
  "footprint": [2, 2],
  "params": {
    "last": { "default": 2, "min": 0, "max": 2, "step": 1, "label": "Last (0 aus, 1 halb, 2 voll)" },
    "feld": { "default": 1, "min": 0, "max": 1, "step": 1, "label": "Einschlussfeld" }
  },
  "let": { "em": "last == 0 ? 0 : (last == 1 ? 0.6 : 1.0)" },
  "variants": { "aus": { "last": 0, "feld": 0 }, "halb": { "last": 1 } },
  "ops": [
    { "op": "box", "name": "Sockel", "at": [-16, 0, -16], "size": [32, 2, 32], "color": "metal_dark" },
    { "op": "box", "name": "Sockel Stufe", "at": [-12, 2, -12], "size": [24, 2, 24], "color": "metal" },
    { "op": "box", "name": "Sockel Goldkante", "at": [-12, 3, -12], "size": [24, 1, 24], "color": { "frame": "trim", "fill": "metal", "axes": "xz", "width": 1 } },
    { "op": "box", "name": "Lüftungsschlitze", "at": [-9, 1, 15], "size": [1, 1, 1], "color": { "role": "glow", "emit": "em * 0.6" }, "repeat": { "count": 7, "step": [3, 0, 0] } },
    { "op": "box", "name": "Kern Fuß", "at": [-6, 4, -6], "size": [12, 2, 12], "color": "trim" },
    { "op": "cyl", "name": "Segment", "at": [0, "6 + i*4", 0], "r": "5.5 - i*0.25", "h": 3, "color": "primary", "repeat": { "count": 5, "var": "i", "step": [0, 0, 0] } },
    { "op": "cyl", "name": "Segmentkante", "at": [0, "9 + i*4", 0], "r": "6.2 - i*0.25", "h": 1, "color": "trim", "repeat": { "count": 5, "var": "i", "step": [0, 0, 0] } },
    { "op": "box", "name": "Sichtschlitz", "at": [-1, 7, 4], "size": [2, 18, 2], "color": { "role": "glow", "emit": "em" }, "mirror": "z", "mirrorAt": 0 },
    { "op": "box", "name": "Sichtschlitz Seite", "at": [4, 7, -1], "size": [2, 18, 2], "color": { "role": "glow", "emit": "em" }, "mirror": "x", "mirrorAt": 0 },
    { "op": "cyl", "name": "Kappe", "at": [0, 26, 0], "r": 4, "r2": 2, "h": 2, "color": "trim" },
    { "op": "cyl", "name": "Emitter", "at": [0, 28, 0], "r": 1.2, "h": 2, "color": { "role": "glow", "emit": "em * 1.2" } },
    { "op": "group", "name": "Feldmasten", "ops": [
      { "op": "box", "name": "Mastfuß", "at": [11, 4, 11], "size": [4, 2, 4], "color": "trim", "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } },
      { "op": "box", "name": "Mast", "at": [12, 6, 12], "size": [2, 24, 2], "color": "metal_dark", "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } },
      { "op": "cyl", "name": "Phalera", "at": [13, "9 + i*6", 13], "r": 2.2, "h": 1, "color": "trim", "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 }, "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "box", "name": "Phalera Kern", "at": [12, "9 + i*6", 12], "size": [2, 1, 2], "color": { "role": "glow", "emit": "em" }, "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 }, "repeat": { "count": 3, "var": "i", "step": [0, 0, 0] } },
      { "op": "box", "name": "Querholm", "at": [10, 29, 12], "size": [6, 1, 2], "color": "trim", "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } },
      { "op": "box", "name": "Mastspitze", "at": [12, 30, 12], "size": [2, 2, 2], "color": { "role": "glow", "emit": "em" }, "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } }
    ] },
    { "op": "box", "name": "Feld vorn", "if": "feld && last > 0", "at": [-11, 21, 12], "size": [22, 1, 1], "color": { "role": "glow", "emit": 0.7 }, "mirror": "z", "mirrorAt": 0 },
    { "op": "box", "name": "Feld Seite", "if": "feld && last > 0", "at": [12, 21, -11], "size": [1, 1, 22], "color": { "role": "glow", "emit": 0.7 }, "mirror": "x", "mirrorAt": 0 },
    { "op": "line", "name": "Feldspeiser", "if": "feld && last > 0", "from": [12, 15, 12], "to": [5, 18, 5], "r": 0.5, "color": { "role": "glow", "emit": 0.6 }, "mirror": "xz", "mirrorAt": { "x": 0, "z": 0 } }
  ],
  "anchor": [0, 0, 0]
}
